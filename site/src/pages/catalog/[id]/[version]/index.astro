---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { isMod, kib } from '../../../../lib/catalog.mjs';
import DownloadButton from '../../../../components/DownloadButton.astro';
import { absolute, breadcrumbLd, ldScript, packageDescription, packageLd } from '../../../../lib/seo.mjs';

export async function getStaticPaths() {
  const all = (await getCollection('catalog')).map((e) => e.data);
  return all.map((e) => ({ params: { id: e.id, version: e.version }, props: { e, all } }));
}
const { e, all } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!;
const repo = e.source_revision.repository;
const commit = e.source_revision.commit;
const successor = e.superseded_by ? all.find((x) => `${x.id}@${x.version}` === e.superseded_by) : undefined;
const deprecated = e.abi_status === 'deprecated';
let latest = successor;   // parseCatalog has validated every chain (targets exist, no cycle), so this terminates at the current package
while (latest?.superseded_by) latest = all.find((x) => `${x.id}@${x.version}` === latest!.superseded_by);
const retention = 'https://github.com/marinocg/segarecomp-patches/blob/main/docs/abi1-retention.md';
const predecessors = all.filter((x) => x.superseded_by === `${e.id}@${e.version}`);
const mod = isMod(e);
const sourceDir = e.source_path ?? e.game_path;   // entries published before the per-patch layout kept their sources under game_path
const trustText = e.trust === 'trusted-native-source'
  ? 'Trusted native source: the package carries C11 source that is compiled and run natively on your machine, unsandboxed. Read the source before you trust it.'
  : 'Data only: a BPS delta and a manifest, no executable code.';
---
<StarlightPage frontmatter={{ title: `${e.name} ${e.version}`, description: packageDescription(e), tableOfContents: false, head: [{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } }, ldScript(packageLd(site, base, e)), ldScript(breadcrumbLd([{ name: 'segarecomp patches', url: absolute(site, base, '/') }, { name: 'Patch catalog', url: absolute(site, base, '/catalog/') }, { name: `${e.name} ${e.version}`, url: absolute(site, base, `/catalog/${e.id}/${e.version}/`) }]))] }}>
  <p><a href={`${base}/catalog/`}>Current packages</a></p>
  {deprecated && <aside aria-label="Deprecated"><p><strong>Deprecated ABI 1 — supported{successor ? '.' : '; replacement not yet published.'}</strong> This package stays published and unchanged under the <a href={retention}>ABI 1 retention policy</a>.</p></aside>}
  {successor && <aside aria-label="Superseded"><p><strong>Superseded</strong> by <a href={`${base}/catalog/${successor.id}/${successor.version}/`}>{successor.id} {successor.version}</a>. {latest !== successor && <>The current package is <a href={`${base}/catalog/${latest!.id}/${latest!.version}/`}>{latest!.id} {latest!.version}</a>. </>}This version stays available and unchanged.</p></aside>}
  {predecessors.length > 0 && <p>Supersedes {predecessors.map((p, i) => <><a href={`${base}/catalog/${p.id}/${p.version}/`}>{p.id} {p.version}</a>{i < predecessors.length - 1 ? ', ' : ''}</>)}.</p>}
  <p>{e.supported_scope}</p>
  <p class="download-cta"><DownloadButton e={e} location="package_page_top" /></p>
  <p class="download-note">Verify the <a href="#digests">SHA-256 digest</a> before installing. {mod ? 'This is a schema 3 / native ABI 2 mod package: it needs a segarecomp build that can install schema 3 packages (see the installation notes).' : 'Needs a segarecomp build that includes the patch installer.'} <a href={`${base}/getting-started/`}>How to install and verify a package</a>.</p>
  <p>This is a segarecomp patch package for {e.game}, not the game and not the segarecomp recompiler itself: it contains no game image and applies only to an image you own that matches the digest below.</p>
  <h2 id="download">Download</h2>
  <p><DownloadButton e={e} location="package_page_download" /></p>
  <p><a href={e.asset.url}>{e.asset.name}</a> from release <code>{e.release}</code> ({kib(e.package_size)}). Verify the digest below before installing. How to install and verify a package: <a href={`${base}/getting-started/`}>getting started</a> and the <a href={`${base}/product/patch-packages/`}>patch package reference</a>.</p>
  <h2 id="digests">Digests</h2>
  <table>
    <caption>Package and source digests</caption>
    <tbody>
      <tr><th scope="row">Package SHA-256</th><td><code>{e.package_sha256}</code></td></tr>
      <tr><th scope="row">Package identity</th><td><code>{e.package_identity}</code></td></tr>
      {!mod && <tr><th scope="row">BPS SHA-256</th><td><code>{e.bps_sha256}</code></td></tr>}
      {!mod && e.native_source_sha256 && <tr><th scope="row">Native source SHA-256</th><td><code>{e.native_source_sha256}</code></td></tr>}
    </tbody>
  </table>
  <h2 id="source">Source revision</h2>
  <table>
    <caption>Exact source revision</caption>
    <tbody>
      <tr><th scope="row">Repository</th><td><a href={repo}>{repo}</a></td></tr>
      <tr><th scope="row">Source directory</th><td><a href={`${repo}/tree/${commit}/${sourceDir}`}><code>{sourceDir}</code></a> at the commit below</td></tr>
      <tr><th scope="row">Commit</th><td><a href={`${repo}/commit/${commit}`}><code>{commit}</code></a></td></tr>
      {e.source_revision.tag && <tr><th scope="row">Release tag</th><td><code>{e.source_revision.tag}</code>{e.source_revision.tag_commit && <> (tag commit <code>{e.source_revision.tag_commit}</code>, same tree as the source commit)</>}</td></tr>}
      <tr><th scope="row">Build</th><td>{e.build.writer} at <code>{e.build.writer_ref}</code>, deterministic: {e.build.deterministic ? 'yes' : 'no'}</td></tr>
    </tbody>
  </table>
  <h2 id="images">Compatible images</h2>
  {mod ? (<>
    <p>Applies only to the exact {e.source_identity_kind === 'cartridge-image-sha256' ? 'cartridge image' : 'disc image'} below, identified by SHA-256 (BIOS: {e.bios_requirement}). A title or region name is not an identity. This is a source-based mod: it has no BPS delta and no patched image, and it is applied to the image you own when it is installed.</p>
    <table>
      <caption>Images this package targets</caption>
      <thead><tr><th scope="col">Label</th><th scope="col">Image SHA-256</th></tr></thead>
      <tbody>{e.images.map((i) => <tr><th scope="row">{i.label}</th><td><code>{i.sha256}</code></td></tr>)}</tbody>
    </table>
  </>) : (<>
    <p>Applies only to the exact {e.source_identity_kind === 'cartridge-image-sha256' ? 'cartridge image' : 'disc image'} with this SHA-256 ({e.revision}, {e.region}; BIOS: {e.bios_requirement}). A title or region name is not an identity.</p>
    <table>
      <caption>Image digests</caption>
      <tbody>
        <tr><th scope="row">Source image SHA-256</th><td><code>{e.source_image_sha256}</code></td></tr>
        <tr><th scope="row">Patched image SHA-256</th><td><code>{e.patched_image_sha256}</code></td></tr>
      </tbody>
    </table>
  </>)}
  <h2 id="trust">Trust and evidence</h2>
  <table>
    <caption>Trust class and compatibility evidence</caption>
    <tbody>
      <tr><th scope="row">Trust class</th><td><code>{e.trust}</code></td></tr>
      <tr><th scope="row">Package schema / SDK ABI</th><td>{e.schema_version}{e.native_abi ? ` / ${e.native_abi}` : ''}</td></tr>
      {mod && <tr><th scope="row">Required capabilities</th><td>{e.capabilities.map((c, i) => <><code>{c}</code>{i < e.capabilities.length - 1 ? ', ' : ''}</>)}</td></tr>}
      <tr><th scope="row">Evidence tier</th><td><code>{e.evidence_tier}</code></td></tr>
      <tr><th scope="row">Licence</th><td>{e.license}</td></tr>
      <tr><th scope="row">Gameplay</th><td>{e.gameplay}</td></tr>
    </tbody>
  </table>
  <p>{trustText} See <a href={`${base}/security/`}>security</a>.</p>
  {e.limitations.length > 0 && <><h2 id="limitations">Limitations</h2><ul>{e.limitations.map((l) => <li>{l}</li>)}</ul></>}
</StarlightPage>
<style>
  .download-cta { margin: 1.25rem 0 0.5rem; }
  .download-note { margin-top: 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
</style>
